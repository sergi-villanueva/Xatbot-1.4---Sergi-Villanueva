   "source": [
    "import google.generativeai as genai\n",
    "import requests\n",
    "from bs4 import BeautifulSoup\n",
    "from flask import Flask, request, jsonify\n",
    "from pyngrok import ngrok\n",
    "import os\n",
    "\n",
    "# ================= CONFIG =================\n",
    "GEMINI_API_KEY = \"la_teva_clau_d_aqui\"  # https://aistudio.google.com/app/apikey\n",
    "WORDPRESS_URL = \"https://el teu wordpress.com\"  # Canvia-ho!\n",
    "\n",
    "genai.configure(api_key=GEMINI_API_KEY)\n",
    "model = genai.GenerativeModel('gemini-2.0-flash')\n",
    "\n",
    "app = Flask(__name__)\n",
    "\n",
    "def scrape_wordpress():\n",
    "    \"\"\"Agafa contingut dinàmic de la teva web\"\"\"\n",
    "    try:\n",
    "        r = requests.get(WORDPRESS_URL, timeout=10)\n",
    "        soup = BeautifulSoup(r.text, 'html.parser')\n",
    "        \n",
    "        # Exemples: agafa títols, contingut principal, serveis, etc.\n",
    "        texts = [tag.get_text(strip=True) for tag in soup.find_all(['h1','h2','p','li'])][:30]\n",
    "        return \" \".join(texts[:1500])  # Limit per context\n",
    "    except:\n",
    "        return \"No s'ha pogut carregar la pàgina.\"\n",
    "\n",
    "@app.route('/chat', methods=['POST'])\n",
    "def chat():\n",
    "    user_message = request.json.get('message')\n",
    "    context = scrape_wordpress()\n",
    "    \n",
    "    prompt = f\"\"\"Ets un assistent expert del meu negoci. Aquí tens el contingut actual de la meva web:\n",
    "{context}\n",
    "\n",
    "Usuari: {user_message}\n",
    "Respon de forma professional, útil i en català.\"\"\"\n",
    "    \n",
    "    response = model.generate_content(prompt)\n",
    "    return jsonify({\"reply\": response.text})\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    public_url = ngrok.connect(5000)\n",
    "    print(f\"🚀 Chatbot en viu a: {public_url}\")\n",
    "    app.run(port=5000)"
   ]
  }
